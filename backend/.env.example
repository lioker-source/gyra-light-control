# Konfiguration fuer den NATIVEN Betrieb des Backends
# (ohne Docker, z.B. per PM2 oder systemd - siehe ops/).
#
#   cp .env.example .env && nano .env
#
# Im Docker-Betrieb wird diese Datei nicht gebraucht: dort kommen die
# Werte aus der Root-.env ueber docker-compose.yml und haben Vorrang.
# Auskommentierte Zeilen zeigen den eingebauten Default.

# --- Datenbank ---------------------------------------------------
DB_HOST=127.0.0.1
# 3306 im Normalbetrieb; 3307, wenn das Backend nativ auf dem Host
# gegen die Docker-Testdatenbank laufen soll.
DB_PORT=3306
DB_USER=gyra
DB_PASSWORD=CHANGE_ME
DB_NAME=lichtsteuerung

# --- WebSocket ---------------------------------------------------
WS_PORT=8080
# Ping-Intervall; erkennt tote Verbindungen (z.B. Tablet aus).
#WS_PING_INTERVAL_MS=15000

# --- Art-Net -----------------------------------------------------
ARTNET_HOST=192.168.178.40
ARTNET_UNIVERSE=0
# unicast = gezielt an ARTNET_HOST, broadcast = an ARTNET_BROADCAST_ADDR
ARTNET_MODE=unicast
ARTNET_BROADCAST_ADDR=255.255.255.255
# ArtSync nur einschalten, wenn die Nodes es unterstuetzen - sonst
# frieren sie rund 4 Sekunden ein.
ARTNET_SYNC=false
# Auf ARTNET_PORT lauschen, um ArtPoll zu beantworten. false, wenn auf
# demselben Rechner schon eine Konsole oder ein Analyzer auf 6454 hoert.
ARTNET_DISCOVERY=true
#ARTNET_PORT=6454
#ARTNET_SHORT_NAME=AtriumLight
#ARTNET_LONG_NAME=Atrium Light Server

# --- Timing und Bedienverhalten ----------------------------------
TICK_HZ=40
#STATE_HZ=10
#STATE_KEEPALIVE_MS=1000
PAD_SENSITIVITY=1.0
JOY_FULL_RANGE_SEC=2.0
# Totmann-Schaltung: bleibt eine Bewegungsmeldung laenger aus, stoppt
# der Kopf.
#ML_MOVE_TIMEOUT_MS=400
#POSITION_SLOT_COUNT=9
#POSITION_FADE_SEC=1.0

# --- Diagnose ----------------------------------------------------
#DEBUG_WS_IN=false
#DEBUG_TICKS=false
#DEBUG_ERRORS=true
