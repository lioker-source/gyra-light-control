DB_HOST=127.0.0.1
# 3306 im Container/Normalbetrieb; 3307, wenn das Backend nativ
# auf dem Host gegen die Docker-Testdatenbank laufen soll.
DB_PORT=3306
DB_USER=gyra
DB_PASSWORD=CHANGE_ME
DB_NAME=lichtsteuerung
WS_PORT=8080
TICK_HZ=40
ARTNET_HOST=192.168.178.40
ARTNET_UNIVERSE=0
# unicast = gezielt an ARTNET_HOST, broadcast = an ARTNET_BROADCAST_ADDR
ARTNET_MODE=unicast
ARTNET_BROADCAST_ADDR=255.255.255.255
PAD_SENSITIVITY=1.0
JOY_FULL_RANGE_SEC=2.0
