[Unit]
Description=Atrium Light Server (Node.js)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=gyra
WorkingDirectory=/opt/lightserver
ExecStart=/usr/bin/node /opt/lightserver/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
