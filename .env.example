# Konfiguration der lokalen Docker-Testumgebung.
#   cp .env.example .env

# ---------------------------------------------------------------
# Art-Net-Ziel
# ---------------------------------------------------------------
# Standard: der mitgelieferte Monitor-Container (http://localhost:8082).
# Für echte Hardware hier die IP des Art-Net-Nodes/Interfaces eintragen,
# z.B. ARTNET_HOST=192.168.178.40
ARTNET_HOST=artnet-monitor
ARTNET_UNIVERSE=0

# Versandart der ArtDMX-Pakete:
#   unicast   = gezielt an ARTNET_HOST (Default)
#   broadcast = an ARTNET_BROADCAST_ADDR, erreicht alle Nodes im Netz
ARTNET_MODE=unicast
# Nur bei ARTNET_MODE=broadcast relevant. 255.255.255.255 geht meist,
# zuverlässiger ist die Subnetz-Broadcast-Adresse des Lichtnetzes,
# z.B. ARTNET_BROADCAST_ADDR=192.168.178.255 (Art-Net-Norm: 2.255.255.255).
ARTNET_BROADCAST_ADDR=255.255.255.255

# ArtSync nach den ArtDMX-Paketen jedes Ticks. Nur einschalten, wenn die
# Nodes es unterstuetzen: im Sync-Modus geben sie erst nach dem ArtSync aus,
# und bleibt es aus, frieren sie rund 4 Sekunden ein.
ARTNET_SYNC=false

# Auf ARTNET_PORT lauschen, um ArtPoll zu beantworten. Auf false setzen,
# wenn auf demselben Rechner schon eine Konsole oder ein Analyzer auf 6454
# hoert: bei mehreren Sockets auf demselben Port bekommt nur EINER die
# Pakete, man wuerde dem anderen Programm sonst den Empfang wegnehmen.
ARTNET_DISCOVERY=true

# ---------------------------------------------------------------
# Frontend → WebSocket
# ---------------------------------------------------------------
# Leer lassen = das Frontend nimmt automatisch den Host aus der
# Browser-Adresszeile (funktioniert für localhost und für den Zugriff
# vom Tablet über die LAN-IP des Entwicklungsrechners).
# Nur setzen, wenn das Backend woanders läuft als das Frontend.
LIGHT_WS_HOST=
LIGHT_WS_PORT=8080

# ---------------------------------------------------------------
# Sonstiges
# ---------------------------------------------------------------
TICK_HZ=40
DEBUG_WS_IN=false
