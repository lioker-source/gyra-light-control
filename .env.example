# ==================================================================
# Atrium Light - Konfiguration der Docker-Umgebung
#
#   cp .env.example .env      (macht ./start.sh automatisch)
#
# ALLE Werte hier sind optional: docker-compose.yml kennt fuer jeden
# den gleichen Default. Eine leere oder fehlende .env startet also
# genauso wie diese Datei. Was auskommentiert ist, gilt trotzdem -
# die Zeile zeigt nur, welcher Wert eingesetzt wird.
# ==================================================================


# ------------------------------------------------------------------
# Ports auf dem Host
# ------------------------------------------------------------------
# Weboberflaeche (das Pult). 80 = Aufruf ohne Portangabe:
# http://<Server-IP>/  . Nur aendern, wenn 80 schon belegt ist.
#WEB_PORT=80

# WebSocket-Port. Bestimmt BEIDES: den veroeffentlichten Docker-Port
# und den Port, den die Seite dem Browser nennt.
# Achtung auf Rechnern mit grandMA3 onPC: dessen Web-Remote belegt
# 8080 und gewinnt gegen Docker - dort z.B. 8090 setzen.
#LIGHT_WS_PORT=8080

# Art-Net-Monitor (Ersatz fuer echte Hardware, zeigt die DMX-Werte).
#MONITOR_PORT=8082

# MariaDB nach aussen, fuer Workbench/DBeaver o.ae.
#DB_PORT_HOST=3307

# ------------------------------------------------------------------
# HTTPS (optional, nur mit  docker compose --profile https up -d )
# ------------------------------------------------------------------
# Noetig, damit sich das Pult auf Android als echte App installiert und
# im Vollbild ohne Adressleiste laeuft. Ohne HTTPS bleibt es eine
# Webseite mit Chrome-Leiste. Ablauf siehe README, Abschnitt
# "Als App auf dem Tablet (PWA)".
#
# Der Name, unter dem das Tablet das Pult aufruft. GENAU dieser Name muss
# am Tablet in der Adresszeile stehen, sonst passt das Zertifikat nicht.
# Ohne Angabe nimmt Caddy 'localhost' - das taugt nur zum Ausprobieren
# auf dem Server selbst, nie fuer den Zugriff vom Tablet.
#
# Ein echter Hostname ist einer nackten IP vorzuziehen: Android behandelt
# eine IP in der Link-Verwaltung als nicht zuordenbar, und beim Praegen der
# WebAPK ist ein Name der verlaesslichere Weg. Der Name muss im LAN
# aufloesbar sein (Router-DNS, z. B. <geraetename>.fritz.box).
#LIGHT_HOST=atrium.fritz.box

# Zweiter Name im selben Zertifikat, ueblicherweise die LAN-IP. Damit
# bleibt der Zugriff ueber die IP erreichbar, waehrend auf den Hostnamen
# umgestellt wird. Muss sich von LIGHT_HOST unterscheiden.
#LIGHT_ALT_HOST=192.168.178.110

# Port fuer HTTPS. 443 = Aufruf als https://<Server-IP>/ ohne Portangabe.
#HTTPS_PORT=443

# Caddy leitet http auf https um. Port 80 hat aber schon das Frontend.
# Entweder hier einen freien Port lassen (Default) oder das Frontend mit
# WEB_PORT=8081 wegruecken und hier HTTPS_REDIRECT_PORT=80 setzen.
#HTTPS_REDIRECT_PORT=8880


# ------------------------------------------------------------------
# Art-Net-Ziel
# ------------------------------------------------------------------
# Standard: der mitgelieferte Monitor-Container.
# Fuer echte Hardware hier die IP des Art-Net-Nodes eintragen,
# z.B. ARTNET_HOST=192.168.178.40
ARTNET_HOST=artnet-monitor
ARTNET_UNIVERSE=0

# Versandart der ArtDMX-Pakete:
#   unicast   = gezielt an ARTNET_HOST (Default)
#   broadcast = an ARTNET_BROADCAST_ADDR, erreicht alle Nodes im Netz
ARTNET_MODE=unicast

# Nur bei ARTNET_MODE=broadcast relevant. 255.255.255.255 geht meist,
# zuverlaessiger ist die Subnetz-Broadcast-Adresse des Lichtnetzes,
# z.B. ARTNET_BROADCAST_ADDR=192.168.178.255 (Art-Net-Norm: 2.255.255.255).
# Hinweis: im Bridge-Netz von Compose bleibt ein Broadcast haengen und
# erreicht keine Hardware im LAN - dafuer unicast nehmen.
ARTNET_BROADCAST_ADDR=255.255.255.255

# ArtSync nach den ArtDMX-Paketen jedes Ticks. Nur einschalten, wenn die
# Nodes es unterstuetzen: im Sync-Modus geben sie erst nach dem ArtSync aus,
# und bleibt es aus, frieren sie rund 4 Sekunden ein.
ARTNET_SYNC=false

# Auf ARTNET_PORT lauschen, um ArtPoll zu beantworten. Auf false setzen,
# wenn auf demselben Rechner schon eine Konsole oder ein Analyzer auf 6454
# hoert: bei mehreren Sockets auf demselben Port bekommt nur EINER die
# Pakete, man wuerde dem anderen Programm sonst den Empfang wegnehmen.
ARTNET_DISCOVERY=true

# Art-Net-Port. 6454 ist genormt, praktisch nie zu aendern.
#ARTNET_PORT=6454

# Namen, unter denen sich der Server im ArtPollReply meldet
# (max. 17 bzw. 63 Zeichen).
#ARTNET_SHORT_NAME=AtriumLight
#ARTNET_LONG_NAME=Atrium Light Server


# ------------------------------------------------------------------
# Frontend -> WebSocket
# ------------------------------------------------------------------
# Leer lassen = das Frontend nimmt automatisch den Host aus der
# Browser-Adresszeile (funktioniert fuer localhost und fuer den Zugriff
# vom Tablet ueber die LAN-IP des Servers).
# Nur setzen, wenn das Backend woanders laeuft als das Frontend.
LIGHT_WS_HOST=


# ------------------------------------------------------------------
# Datenbank
# ------------------------------------------------------------------
# ACHTUNG: diese Werte gelten nur beim ERSTEN Start, denn danach liegt
# die Datenbank im Volume db-data. Nachtraeglich geaendert wirken sie
# erst nach ./start.sh reset (loescht alle Presets und Positionen!).
#DB_NAME=lichtsteuerung
#DB_USER=gyra
#DB_PASSWORD=gyra
#DB_ROOT_PASSWORD=root


# ------------------------------------------------------------------
# Timing und Bedienverhalten
# ------------------------------------------------------------------
# DMX-Ausgabe pro Sekunde. 40 ist die Art-Net-Empfehlung.
TICK_HZ=40

# Wie oft der Server seinen Zustand an alle Clients schickt, und nach
# welcher Ruhe er ihn auch ohne Aenderung wiederholt (Keepalive).
#STATE_HZ=10
#STATE_KEEPALIVE_MS=1000

# WebSocket-Ping-Intervall; erkennt tote Verbindungen (z.B. Tablet aus).
#WS_PING_INTERVAL_MS=15000

# Empfindlichkeit des Touch-Pads (1.0 = normal, groesser = schneller).
#PAD_SENSITIVITY=1.0

# Sekunden, die der Joystick fuer den vollen Pan-/Tilt-Weg braucht.
#JOY_FULL_RANGE_SEC=2.0

# Totmann-Schaltung: bleibt eine Bewegungsmeldung laenger aus, stoppt
# der Kopf. Schuetzt vor Weiterlaufen bei Verbindungsabbruch.
#ML_MOVE_TIMEOUT_MS=400

# Anzahl der Positions-Buttons und deren Standard-Fadezeit.
#POSITION_SLOT_COUNT=9
#POSITION_FADE_SEC=1.0


# ------------------------------------------------------------------
# Diagnose (nur zum Fehlersuchen einschalten, erzeugt viel Ausgabe)
# ------------------------------------------------------------------
DEBUG_WS_IN=false
#DEBUG_TICKS=false
#DEBUG_ERRORS=true
